# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
*.egg
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# IDE
.idea/
.vscode/

# Claude Code local settings
.claude/settings.local.json

# Orchestration state (system retired 2026-09; kept as a guard so a stray
# recreation by external tooling can never be committed)
.omc/
.omx/

# Paper source (not version-controlled here; tracked in its own nested repo)
paper/
# arXiv build output. The 2026-04-30 snapshot was deleted post-acceptance, but
# the rule stays: any future rebuild lands here, and losing the rule would let
# a LaTeX build tree and paper PDF reach this public repo.
arxiv/

# Experiment data (published via HuggingFace)
results/

# Agent workspaces (ephemeral, regenerated per run)
workspace/

# HuggingFace staging (large, regenerable)
artifacts/huggingface-staging/
artifacts/paper-build/
artifacts/reports/

# API keys and credentials (NEVER commit)
configs/api_keys.yaml
configs/api_keys.json
configs/claude_credentials.json
configs/*_credentials.json
configs/*_credentials.yaml

# Checkpoint files (crash recovery)
*.checkpoint.jsonl

# Playwright MCP logs
.playwright-mcp/

# Temp / scratch
*.tmp
*.swp
*.log
.cache/

# AI-assistant collaboration artifacts (dev-local, not for reviewers/public)
AGENTS.md
CLAUDE.md
.claude/
.drawio/

# Dev-local documentation store (strategy notes, rebuttal drafts, AI-only docs)
docs/
